{
  "manifest_version": 3,
  "name": "Job Match Analyzer",
  "version": "2.0.0",
  "description": "Triple-click job page to capture JD and auto-analyze resume match per tab.",
  "permissions": [
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://resume-analyser-backend-7132.onrender.com/*"
  ],
  "action": {
    "default_popup": "src/Popup/index.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}